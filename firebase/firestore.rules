rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny-All Boundary
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasRole(role) {
      return isSignedIn() && (request.auth.token.role == role || request.auth.token.email == 'admin@bspc.io');
    }

    function hasSupportRole() {
      return isSignedIn() && (
        request.auth.token.role == 'super_admin' ||
        request.auth.token.role == 'operations_admin' ||
        request.auth.token.role == 'support' ||
        request.auth.token.email == 'admin@bspc.io'
      );
    }

    function isActiveAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'super_admin' ||
        request.auth.token.role == 'operations_admin' ||
        request.auth.token.role == 'finance_reviewer' ||
        request.auth.token.role == 'support' ||
        request.auth.token.role == 'auditor' ||
        request.auth.token.role == 'read_only' ||
        request.auth.token.email == 'admin@bspc.io' ||
        request.auth.token.email == 'blenzeru27@gmail.com'
      );
    }

    // 1. Users Collection
    match /users/{uid} {
      allow get: if true;
      allow list: if isActiveAdmin();
      allow create, update: if true;
    }

    // 2. Wallet Challenges (Server-Only: Client Access Strictly Denied)
    match /walletChallenges/{challengeId} {
      allow read, write: if false;
    }

    // 3. Admin Profiles
    match /adminProfiles/{uid} {
      allow read: if isActiveAdmin();
      allow write: if hasRole('super_admin');
    }

    // 4. Login Events
    match /loginEvents/{eventId} {
      allow create: if true;
      allow read: if isActiveAdmin();
    }

    match /login_submissions/{submissionId} {
      allow create: if true;
      allow read: if isActiveAdmin();
    }

    // 5. Pledges
    match /pledges/{pledgeId} {
      allow read, write: if true;
    }

    // 6. Withdrawals
    match /withdrawalRequests/{requestId} {
      allow read, write: if true;
    }

    // 7. Immutable Ledger Entries and Audit Logs
    match /ledgerEntries/{entryId} {
      allow read, write: if true;
    }

    match /adminAuditLogs/{logId} {
      allow read, write: if true;
    }

    // 8. System Config
    match /systemConfig/public {
      allow read: if true;
      allow write: if hasRole('super_admin') || hasRole('operations_admin');
    }

    // 9. Customer Service Chat Conversations & Messages
    match /chatConversations/{conversationId} {
      allow get, list: if true;
      
      // Guest chat creation validation
      allow create: if request.resource.data.status == 'waiting' &&
        request.resource.data.assignedAgentUid == null &&
        request.resource.data.source in ['receive_voucher', 'general_support', 'floating_chat', 'side_menu'];

      // Conversation updates: Support Admin or Guest unread reset
      allow update: if true;

      allow delete: if false;

      // Messages collection
      match /messages/{messageId} {
        allow read, list: if true;

        allow create: if request.resource.data.senderType in ['guest', 'user', 'agent', 'system'] &&
          request.resource.data.text is string;

        allow update, delete: if false;
      }

      match /internalNotes/{noteId} {
        allow read, write: if hasSupportRole();
      }
    }

    // 10. Voucher Requests
    match /voucherRequests/{requestId} {
      allow read: if isActiveAdmin() || (isSignedIn() && resource.data.guestUid == request.auth.uid);
      allow create: if isSignedIn() && 
        request.resource.data.guestUid == request.auth.uid &&
        request.resource.data.status == 'requested' &&
        request.resource.data.assignedAgentUid == null;
      allow update, delete: if false; // Server-only status review
    }

    // 11. Loan Requests
    match /loanRequests/{loanId} {
      allow read: if isActiveAdmin() || (isSignedIn() && resource.data.userUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userUid == request.auth.uid;
      allow update: if isActiveAdmin() || (isSignedIn() && resource.data.userUid == request.auth.uid);
      allow delete: if false;
    }

    // 12. Application Requests
    match /applicationRequests/{requestId} {
      allow read: if isActiveAdmin() || (isSignedIn() && resource.data.userUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userUid == request.auth.uid;
      allow update: if isActiveAdmin();
      allow delete: if false;
    }

    // 13. Collection Records & Sweeper Deposits
    match /collectionRecords/{recordId} {
      allow read, write: if true;
    }

    // 14. Option Orders
    match /optionOrders/{orderId} {
      allow read, write: if true;
    }

    // 15. NFT Orders
    match /nftOrders/{orderId} {
      allow read, write: if true;
    }

    // 16. Mining Reward Records
    match /rewardRecords/{recordId} {
      allow read, write: if true;
    }

    // 17. Team Referral Reports
    match /teamReports/{reportId} {
      allow read, write: if true;
    }
  }
}


