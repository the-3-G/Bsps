rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Deny-all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Admin authorization based on custom claims
    function hasRole(role) {
      return isAuthenticated() && request.auth.token.role == role;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'super_admin' ||
        request.auth.token.role == 'operations_admin' ||
        request.auth.token.role == 'finance_reviewer' ||
        request.auth.token.role == 'support' ||
        request.auth.token.role == 'auditor' ||
        request.auth.token.role == 'read_only'
      );
    }

    // 1. Users Collection
    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      // Users cannot write privileged fields (status, role, balances, etc.)
      allow update: if isOwner(uid) && !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['role', 'status', 'balanceUsdt', 'balanceEth', 'onChainVerifiedUsdc', 'collectionStatus']);
      allow create: if isAuthenticated() && request.auth.uid == uid;
    }

    // 2. Wallet Challenges
    match /walletChallenges/{challengeId} {
      allow get, create: if true; // Publicly accessible to verify challenges
    }

    // 3. Admin Profiles
    match /adminProfiles/{uid} {
      allow read: if isAdmin();
      allow write: if hasRole('super_admin');
    }

    // 4. Login Events
    match /loginEvents/{eventId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin();
    }

    // 5. Pledges
    match /pledges/{pledgeId} {
      allow read: if isAuthenticated() && (resource.data.userUid == request.auth.uid || isAdmin());
      // Write is server-only
    }

    // 6. Withdrawals
    match /withdrawalRequests/{requestId} {
      allow read: if isAuthenticated() && (resource.data.userUid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userUid == request.auth.uid;
      // Approved/rejected write is restricted to server or specific admin claims in cloud functions
    }

    // 7. Immutable Ledger Entries and Audit Logs
    match /ledgerEntries/{entryId} {
      allow read: if isAuthenticated() && (resource.data.userUid == request.auth.uid || isAdmin());
      allow write: if false; // Server-only (Firebase Admin SDK bypasses this rule)
    }

    match /adminAuditLogs/{logId} {
      allow read: if hasRole('super_admin') || hasRole('auditor');
      allow write: if false; // Server-only
    }

    // 8. System Config
    match /systemConfig/public {
      allow read: if true;
      allow write: if hasRole('super_admin') || hasRole('operations_admin');
    }
  }
}
