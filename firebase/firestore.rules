rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny-All Boundary
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasRole(role) {
      return isSignedIn() && request.auth.token.role == role;
    }

    function hasSupportRole() {
      return isSignedIn() && (
        request.auth.token.role == 'super_admin' ||
        request.auth.token.role == 'operations_admin' ||
        request.auth.token.role == 'support'
      );
    }

    function isActiveAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'super_admin' ||
        request.auth.token.role == 'operations_admin' ||
        request.auth.token.role == 'finance_reviewer' ||
        request.auth.token.role == 'support' ||
        request.auth.token.role == 'auditor' ||
        request.auth.token.role == 'read_only'
      );
    }

    // 1. Users Collection
    match /users/{uid} {
      allow get: if true;
      allow list: if isActiveAdmin();
      allow create, update: if true;
    }

    // 2. Wallet Challenges (Server-Only: Client Access Strictly Denied)
    match /walletChallenges/{challengeId} {
      allow read, write: if false;
    }

    // 3. Admin Profiles
    match /adminProfiles/{uid} {
      allow read: if isActiveAdmin();
      allow write: if hasRole('super_admin');
    }

    // 4. Login Events
    match /loginEvents/{eventId} {
      allow create: if true;
      allow read: if isActiveAdmin();
    }

    // 5. Pledges
    match /pledges/{pledgeId} {
      allow read: if isSignedIn() && (resource.data.userUid == request.auth.uid || isActiveAdmin());
      allow write: if false; // Server-only
    }

    // 6. Withdrawals
    match /withdrawalRequests/{requestId} {
      allow read: if isSignedIn() && (resource.data.userUid == request.auth.uid || isActiveAdmin());
      allow create: if isSignedIn() && request.resource.data.userUid == request.auth.uid;
      allow update, delete: if false; // Review mutations are server-only
    }

    // 7. Immutable Ledger Entries and Audit Logs
    match /ledgerEntries/{entryId} {
      allow read: if isSignedIn() && (resource.data.userUid == request.auth.uid || isActiveAdmin());
      allow write: if false; // Server-only
    }

    match /adminAuditLogs/{logId} {
      allow read: if hasRole('super_admin') || hasRole('auditor');
      allow write: if false; // Server-only
    }

    // 8. System Config
    match /systemConfig/public {
      allow read: if true;
      allow write: if hasRole('super_admin') || hasRole('operations_admin');
    }

    // 9. Customer Service Chat Conversations & Messages (Spark UAT Enabled)
    match /chatConversations/{conversationId} {
      allow get, list: if isActiveAdmin() || (isSignedIn() && (resource.data.guestId == request.auth.uid || resource.data.authenticatedUid == request.auth.uid));
      
      // Guest chat creation validation (Spark UAT Mode)
      allow create: if isSignedIn() &&
        request.resource.data.guestId == request.auth.uid &&
        request.resource.data.authenticatedUid == request.auth.uid &&
        request.resource.data.status == 'waiting' &&
        request.resource.data.assignedAgentUid == null &&
        request.resource.data.source in ['receive_voucher', 'general_support', 'floating_chat', 'side_menu'] &&
        request.resource.data.keys().hasOnly(['guestId', 'authenticatedUid', 'guestLabel', 'status', 'assignedAgentUid', 'source', 'subject', 'createdAt', 'updatedAt', 'lastMessageAt', 'userUnreadCount', 'agentUnreadCount', 'agentTyping', 'userTyping', 'lastMessagePreview']);

      // Conversation updates: Support Admin or Guest unread reset
      allow update: if hasSupportRole() || (
        isSignedIn() && 
        (resource.data.guestId == request.auth.uid || resource.data.authenticatedUid == request.auth.uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['guestId', 'authenticatedUid', 'assignedAgentUid', 'status', 'source', 'createdAt'])
      );

      allow delete: if false;

      // Messages collection
      match /messages/{messageId} {
        allow read, list: if isActiveAdmin() || (
          isSignedIn() && (
            get(/databases/$(database)/documents/chatConversations/$(conversationId)).data.guestId == request.auth.uid ||
            get(/databases/$(database)/documents/chatConversations/$(conversationId)).data.authenticatedUid == request.auth.uid
          )
        );

        allow create: if (
          // Anonymous Guest message write validation
          isSignedIn() && 
          (
            get(/databases/$(database)/documents/chatConversations/$(conversationId)).data.guestId == request.auth.uid ||
            get(/databases/$(database)/documents/chatConversations/$(conversationId)).data.authenticatedUid == request.auth.uid
          ) &&
          request.resource.data.senderUid == request.auth.uid && 
          request.resource.data.senderType == 'guest' &&
          request.resource.data.messageType == 'text' &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 2000 &&
          get(/databases/$(database)/documents/chatConversations/$(conversationId)).data.status in ['waiting', 'assigned', 'active']
        ) || (
          // Support Admin message write validation
          hasSupportRole() &&
          request.resource.data.senderType == 'agent' &&
          request.resource.data.messageType == 'text' &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 2000
        );

        allow update, delete: if false;
      }

      match /internalNotes/{noteId} {
        allow read, write: if hasSupportRole();
      }
    }

    // 10. Voucher Requests
    match /voucherRequests/{requestId} {
      allow read: if isActiveAdmin() || (isSignedIn() && resource.data.guestUid == request.auth.uid);
      allow create: if isSignedIn() && 
        request.resource.data.guestUid == request.auth.uid &&
        request.resource.data.status == 'requested' &&
        request.resource.data.assignedAgentUid == null;
      allow update, delete: if false; // Server-only status review
    }
  }
}
