# Server-Only Cloud Functions Environment Variables Template
# DO NOT expose these variables to client applications via NEXT_PUBLIC_

# Authoritative Blockchain & Indexer Settings
REQUIRED_CONFIRMATIONS=6
INDEXER_START_BLOCK=5000000
SUPPORTED_CHAIN_IDS=11155111
USDC_CONTRACT_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238

# Wallet Challenge Authentication Boundaries
WALLET_AUTH_DOMAIN=bspc.io
WALLET_AUTH_URI=https://bspc.io
WALLET_CHALLENGE_TTL_SECONDS=300

# Security Flags
ENFORCE_APP_CHECK=false
DEVELOPMENT_TESTNET_ONLY=true

# Emulator Mappings
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FUNCTIONS_EMULATOR_HOST=localhost:5001
